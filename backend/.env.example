# Salin ke .env (JANGAN commit .env yang asli).
# Kunci admin untuk endpoint manajemen (devices/users/commands). Ganti dengan
# string acak panjang di produksi, mis. `openssl rand -hex 32`.
ADMIN_API_KEY=change-me-super-secret-admin-key

# Lokasi database. Default SQLite file lokal, cukup untuk Phase 4 / bench-test.
# Untuk produksi ganti mis. postgresql+psycopg://user:pass@host/dbname
DATABASE_URL=sqlite:///./biometric_smart_key.db

# Jendela toleransi waktu (detik) untuk anggap timestamp permintaan/perintah
# masih segar (anti-replay kasar, selaras SRS 12.5).
COMMAND_FRESHNESS_WINDOW_SEC=120

# [PHASE BOUNDARY] Matikan (false) untuk menjalankan backend sebagai
# "Phase 3 murni": /api/v1/users dan /api/v1/commands* TIDAK terdaftar sama
# sekali (404, bukan 401/403) -- app/routers/phase4/ tidak pernah diimpor.
# Berguna saat menguji atau mem-branch `phase-3` terpisah dari `phase-4`
# (lihat wiki/Architecture.md dan wiki/Contributing.md).
PHASE4_ENABLED=true
